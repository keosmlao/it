    "db:smoke-loans": "node --env-file=.env.local scripts/smoke-loans.mjs",
    "db:smoke-plans": "node --env-file=.env.local scripts/smoke-plans.mjs",
    "db:smoke-pr": "node --env-file=.env.local scripts/smoke-pr-erp.mjs",
    "smoke:pr-sml": "node --env-file=.env.local scripts/smoke-pr-sml.mjs",
    "db:smoke-return": "node --env-file=.env.local scripts/smoke-erp-return.mjs",
